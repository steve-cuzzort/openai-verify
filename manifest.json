{
  "manifest_version": 3,
  "name": "Verify with SynthID",
  "version": "0.3.0",
  "description": "Right-click an image, audio or video player to open Google's SynthID Detector with the file preloaded. You review and confirm the upload yourself.",
  "icons": {
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "synthid-verify@example.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://synthid.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
