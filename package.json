{
  "name": "synthid-verify",
  "version": "0.3.0",
  "private": true,
  "description": "Firefox and Chrome extension: right-click an image, audio or video to open the SynthID Detector with the file preloaded.",
  "license": "MPL-2.0",
  "scripts": {
    "start": "web-ext run",
    "start:chrome": "web-ext run --target chromium",
    "lint": "web-ext lint",
    "package": "web-ext lint && web-ext build --overwrite-dest"
  },
  "webExt": {
    "sourceDir": ".",
    "artifactsDir": "web-ext-artifacts",
    "ignoreFiles": [
      ".idea",
      "package.json",
      "package-lock.json",
      "web-ext-artifacts",
      "README.md",
      "icon.svg"
    ]
  },
  "devDependencies": {
    "web-ext": "^10.7.0"
  }
}
