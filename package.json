{
  "name": "synthid-verify-firefox",
  "version": "0.2.0",
  "private": true,
  "description": "Firefox add-on: right-click an image, audio or video to open the SynthID Detector with the file preloaded.",
  "license": "MPL-2.0",
  "scripts": {
    "start": "web-ext run",
    "lint": "web-ext lint",
    "package": "web-ext lint && web-ext build --overwrite-dest"
  },
  "webExt": {
    "sourceDir": ".",
    "artifactsDir": "web-ext-artifacts",
    "ignoreFiles": [
      ".idea",
      "package.json",
      "package-lock.json",
      "web-ext-artifacts",
      "README.md"
    ]
  },
  "devDependencies": {
    "web-ext": "^10.7.0"
  }
}
